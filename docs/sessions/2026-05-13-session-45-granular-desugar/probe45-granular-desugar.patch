+-- PROBE45: granular per-step length logger inside deSugar.
+-- Pinpoints WHICH step truncates the binds list.
+
+{-# NOINLINE probe45Counter #-}
+probe45Counter :: IORef Int
+probe45Counter = unsafePerformIO (newIORef 0)
+
+probe45LogStep :: String -> Int -> ()
+probe45LogStep step_name n = unsafePerformIO $ do
+    k <- atomicModifyIORef' probe45Counter (\c -> (c+1, c+1))
+    hPutStrLn stderr $ unwords
+      [ "PROBE45-STEP"
+      , "evt=" ++ show k
+      , "step=" ++ step_name
+      , "n=" ++ show n
+      ]
+    hFlush stderr
 
