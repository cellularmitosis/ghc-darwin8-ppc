+import Data.IORef        (IORef, newIORef, atomicModifyIORef')
+import System.IO         (hPutStrLn, stderr, hFlush)
+import System.IO.Unsafe  (unsafePerformIO)
 
 #include "HsVersions.h"
 
+-- PROBE48: drill inside tcRnSrcDecls to find exact truncation step.
+
+{-# NOINLINE probe48Counter #-}
+probe48Counter :: IORef Int
+probe48Counter = unsafePerformIO (newIORef 0)
+
+probe47Log :: String -> TcGblEnv -> ()
+probe47Log site tc_env = unsafePerformIO $ do
+    k <- atomicModifyIORef' probe48Counter (\c -> (c+1, c+1))
+    let n = lengthBag (tcg_binds tc_env)
+    hPutStrLn stderr $ unwords
+      [ "PROBE48"
+      , "evt=" ++ show k
+      , "site=" ++ site
+      , "n=" ++ show n
+      ]
+    hFlush stderr
+
+probe48LogBinds :: String -> LHsBinds GhcTc -> ()
+probe48LogBinds site binds = unsafePerformIO $ do
+    k <- atomicModifyIORef' probe48Counter (\c -> (c+1, c+1))
+    let n = lengthBag binds
+    hPutStrLn stderr $ unwords
+      [ "PROBE48"
+      , "evt=" ++ show k
+      , "site=" ++ site
+      , "n=" ++ show n
+      ]
+    hFlush stderr
+
