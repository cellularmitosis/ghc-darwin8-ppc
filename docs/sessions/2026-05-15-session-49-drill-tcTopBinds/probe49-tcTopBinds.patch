+-- PROBE49: drill INSIDE tcTopBinds to find the loop/recursion
+-- step where the binder count is short-counted from 8 to 2-3.
+
+{-# NOINLINE probe49Counter #-}
+probe49Counter :: IORef Int
+probe49Counter = unsafePerformIO (newIORef 0)
+
+probe49Log :: String -> Int -> ()
+probe49Log site n = unsafePerformIO $ do
+    k <- atomicModifyIORef' probe49Counter (\c -> (c+1, c+1))
+    hPutStrLn stderr $ unwords
+      [ "PROBE49"
+      , "evt=" ++ show k
+      , "site=" ++ site
+      , "n=" ++ show n
+      ]
+    hFlush stderr
+
+-- Total binder count across a [(RecFlag, LHsBinds p)] list.
+probe49TotalBinders :: [(RecFlag, LHsBinds p)] -> Int
+probe49TotalBinders = sum . map (lengthBag . snd)
+
