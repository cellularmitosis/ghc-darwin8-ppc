+import Data.IORef        (IORef, newIORef, atomicModifyIORef')
+import System.IO         (hPutStrLn, stderr, hFlush)
+import System.IO.Unsafe  (unsafePerformIO)
+
+-- PROBE50: drill the renamer's value-binding pass to find
+-- where the [(RecFlag, LHsBinds GhcRn)] becomes truncated
+-- before reaching tcTopBinds.
+
+{-# NOINLINE probe50Counter #-}
+probe50Counter :: IORef Int
+probe50Counter = unsafePerformIO (newIORef 0)
+
+probe50Log :: String -> Int -> ()
+probe50Log site n = unsafePerformIO $ do
+    k <- atomicModifyIORef' probe50Counter (\c -> (c+1, c+1))
+    hPutStrLn stderr $ unwords
+      [ "PROBE50"
+      , "evt=" ++ show k
+      , "site=" ++ site
+      , "n=" ++ show n
+      ]
+    hFlush stderr
+
+probe50TotalBinders :: [(RecFlag, LHsBinds p)] -> Int
+probe50TotalBinders = sum . map (lengthBag . snd)
 
