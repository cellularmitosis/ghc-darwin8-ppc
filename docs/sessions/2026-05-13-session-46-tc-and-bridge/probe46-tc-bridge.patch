+-- PROBE46: trace tcg_binds count between typechecker and desugarer.
+
+{-# NOINLINE probe46Counter #-}
+probe46Counter :: IORef Int
+probe46Counter = unsafePerformIO (newIORef 0)
+
+probe46LogTcgBinds :: String -> TcGblEnv -> ()
+probe46LogTcgBinds site tc_env = unsafePerformIO $ do
+    k <- atomicModifyIORef' probe46Counter (\c -> (c+1, c+1))
+    let n = lengthBag (tcg_binds tc_env)
+    hPutStrLn stderr $ unwords
+      [ "PROBE46-TCGBINDS"
+      , "evt=" ++ show k
+      , "site=" ++ site
+      , "n=" ++ show n
+      ]
+    hFlush stderr
 
