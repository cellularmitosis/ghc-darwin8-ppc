+-- PROBE32: heap-address probe for the refineFromInScope panic.
+-- Reuses the same trick as GHC.Exts.Heap.Closures' Box Show instance.
+import GHC.Exts (Any, Word#)
+import GHC.Word (Word(..))
+import qualified Numeric (showHex)
+import Unsafe.Coerce (unsafeCoerce)
+
+foreign import prim "aToWordzh" probe32_aToWord# :: Any -> Word#
+
+probe32AddrHex :: a -> String
+probe32AddrHex x =
+    let !w = W# (probe32_aToWord# (unsafeCoerce x :: Any))
+    in "0x" ++ Numeric.showHex w ""
