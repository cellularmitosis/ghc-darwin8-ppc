@@ -175,9 +175,30 @@ import Data.Data ( Data )
 import qualified Data.Set as S
 import Control.DeepSeq
 import Control.Monad
+import Data.IORef        (IORef, newIORef, atomicModifyIORef')
+import System.IO         (hPutStrLn, stderr, hFlush)
+import System.IO.Unsafe  (unsafePerformIO)
 
 #include "HsVersions.h"
 
+-- PROBE47: trace tcg_binds count inside the typechecker.
+
+{-# NOINLINE probe47Counter #-}
+probe47Counter :: IORef Int
+probe47Counter = unsafePerformIO (newIORef 0)
+
+probe47Log :: String -> TcGblEnv -> ()
+probe47Log site tc_env = unsafePerformIO $ do
+    k <- atomicModifyIORef' probe47Counter (\c -> (c+1, c+1))
+    let n = lengthBag (tcg_binds tc_env)
+    hPutStrLn stderr $ unwords
+      [ "PROBE47-TC"
+      , "evt=" ++ show k
+      , "site=" ++ site
+      , "n=" ++ show n
+      ]
+    hFlush stderr
+
