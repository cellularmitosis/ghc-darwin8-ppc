+-- PROBE41: pin a SimplEnv reference (the one produced by the FIRST
+-- simplRecBndrs call, expected to be simplTopBinds' env1 with all
+-- top-level binders in scope) in an IORef.  At every substId
+-- failure (the path that fires refineFromInScope), report the
+-- pinned env's current seInScope + seIdSubst sizes.  If the size
+-- at the failure is smaller than at registration, GC has corrupted
+-- the SimplEnv data structure.
+
+probe41Hex :: Int -> String
+probe41Hex i
+  | i < 0     = "-0x" ++ Numeric.showHex (negate i) ""
+  | otherwise = "0x" ++ Numeric.showHex i ""
+
+probe41DescribeVar :: Var -> String
+probe41DescribeVar v =
+    getOccString v ++ "(" ++ probe41Hex (getKey (varUnique v)) ++ ")"
+
+-- Pinned env: (env, scope_size_at_registration, subst_size_at_registration)
+{-# NOINLINE probe41PinnedEnv #-}
+probe41PinnedEnv :: IORef (Maybe (SimplEnv, Int, Int))
+probe41PinnedEnv = unsafePerformIO (newIORef Nothing)
+
+{-# NOINLINE probe41CheckCounter #-}
+probe41CheckCounter :: IORef Int
+probe41CheckCounter = unsafePerformIO (newIORef 0)
+
+-- v2: log EVERY simplRecBndrs call's env size, and update the pin
+-- to the LARGEST env seen so far.  This avoids the "wrong env got
+-- pinned" issue from v1 where a small simplRecBndrs call (e.g., a
+-- non-rec binder) registered before the big top-level call.
+{-# NOINLINE probe41CallCounter #-}
+probe41CallCounter :: IORef Int
+probe41CallCounter = unsafePerformIO (newIORef 0)
+
+probe41Pin :: SimplEnv -> ()
+probe41Pin env = unsafePerformIO $ do
+    n <- atomicModifyIORef' probe41CallCounter (\k -> (k+1, k+1))
+    m <- readIORef probe41PinnedEnv
+    let sz_scope = sizeVarSet (getInScopeVars (seInScope env))
+        sz_subst = sizeUFM (seIdSubst env)
+        update = case m of
+          Nothing                  -> True
+          Just (_, sz_old, _)
+            | sz_scope > sz_old    -> True
+            | otherwise            -> False
+    hPutStrLn stderr $ unwords
+      [ "PROBE41-RECBNDRS"
+      , "call=" ++ show n
+      , "scope=" ++ show sz_scope
+      , "subst=" ++ show sz_subst
+      , "pin=" ++ (if update then "yes" else "no")
+      ]
+    hFlush stderr
+    if update
+      then writeIORef probe41PinnedEnv (Just (env, sz_scope, sz_subst))
+      else return ()
+
+-- Check pinned env's current sizes vs registration-time sizes.
+-- Emit only if sizes have changed (drift).
+probe41Check :: String -> ()
+probe41Check site = unsafePerformIO $ do
+    m <- readIORef probe41PinnedEnv
+    case m of
+      Nothing -> return ()
+      Just (env, sz0_scope, sz0_subst) -> do
+        n <- atomicModifyIORef' probe41CheckCounter (\k -> (k+1, k+1))
+        let sz_scope_now = sizeVarSet (getInScopeVars (seInScope env))
+            sz_subst_now = sizeUFM (seIdSubst env)
+        if sz_scope_now == sz0_scope && sz_subst_now == sz0_subst
+          then return ()   -- No drift
+          else do
+            hPutStrLn stderr $ unwords
+              [ "PROBE41-DRIFT"
+              , "site=" ++ site
+              , "check=" ++ show n
+              , "scope_was=" ++ show sz0_scope
+              , "scope_now=" ++ show sz_scope_now
+              , "subst_was=" ++ show sz0_subst
+              , "subst_now=" ++ show sz_subst_now
+              ]
+            hFlush stderr
+
+-- Failure-site dump (extends probe40's): also emit pinned env's
+-- current sizes alongside the failing env's sizes.
+probe41DumpSubstFail :: InScopeSet -> SimplIdSubst -> Var -> String
+probe41DumpSubstFail in_scope id_subst v = unsafePerformIO $ do
+    m <- readIORef probe41PinnedEnv
+    let sz_scope_fail = sizeVarSet (getInScopeVars in_scope)
+        sz_subst_fail = sizeUFM id_subst
+        pinned_str = case m of
+          Nothing -> "pinned=none"
+          Just (env, sz0_scope, sz0_subst) ->
+            let sz_now = sizeVarSet (getInScopeVars (seInScope env))
+                ss_now = sizeUFM (seIdSubst env)
+            in  "pinned_was=(" ++ show sz0_scope ++ "," ++ show sz0_subst
+                ++ ") pinned_now=(" ++ show sz_now ++ "," ++ show ss_now ++ ")"
+        msg = unwords
+                [ "PROBE41-FAIL"
+                , "v=" ++ probe41DescribeVar v
+                , "fail_scope=" ++ show sz_scope_fail
+                , "fail_subst=" ++ show sz_subst_fail
+                , pinned_str
+                ]
+    hPutStrLn stderr msg
+    hFlush stderr
+    return msg
 
