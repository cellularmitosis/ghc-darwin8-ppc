      (GHC.Types.TrNameS "main"#) (GHC.Types.TrNameS "Big2"#)
cumsum = scanl1 (+)
allPositive = all (> 0)
scaleAndShift s n = map (\ x -> x * s + n)
shift n = map (+ n)
countOf k m = fromMaybe 0 (M.lookup k m)
dedup = map head . group . sort
freqMap xs = M.fromListWith (+) [(x, 1) | x <- xs]
topK k xs
  = take k . reverse . sort . map swap . M.toList $ freqMap xs
  where
      swap (a, b) = (b, a)



