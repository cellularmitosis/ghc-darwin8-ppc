+import System.IO         (hPutStrLn, stderr, hFlush)
+import System.IO.Unsafe  (unsafePerformIO)
+
+-- PROBE40: extend probe38's panic-site dump to also include
+-- seIdSubst's size + first ~20 element Uniques.  Goal: see whether
+-- the SimplEnv at the failing substId/refineFromInScope boundary
+-- has any substitution entries at all, or is "fresh".  If
+-- seIdSubst is small or empty at the panic site, the simplifier is
+-- descending in a way that bypasses simplTopBinds' seIdSubst
+-- population.
+
+{-# NOINLINE probe40Counter #-}
+probe40Counter :: IORef Int
+probe40Counter = unsafePerformIO (newIORef 0)
+
+probe40Hex :: Int -> String
+probe40Hex i
+  | i < 0     = "-0x" ++ Numeric.showHex (negate i) ""
+  | otherwise = "0x" ++ Numeric.showHex i ""
+
+probe40DescribeVar :: Var -> String
+probe40DescribeVar v =
+    getOccString v ++ "(" ++ probe40Hex (getKey (varUnique v)) ++ ")"
+
+-- substId emits this when it's about to call refineFromInScope and
+-- the in-scope set doesn't have v.  (Logged when the lookupInScope
+-- result would be Nothing.)
+probe40DumpSubstFail :: InScopeSet -> SimplIdSubst -> Var -> String
+probe40DumpSubstFail in_scope id_subst v = unsafePerformIO $ do
+    n <- atomicModifyIORef' probe40Counter (\k -> (k+1, k+1))
+    let vu = varUnique v
+        vs = getInScopeVars in_scope
+        sz_scope = sizeVarSet vs
+        sz_subst = sizeUFM id_subst
+        -- First 20 element descriptions of in_scope (truncated)
+        els = take 20 (nonDetEltsUniqSet vs)
+        scope_desc = unwords (map probe40DescribeVar els)
+        -- First 20 keys of id_subst (Uniques as Int)
+        subst_keys = take 20 (nonDetKeysUFM id_subst)
+        subst_keys_desc = unwords (map (probe40Hex . getKey) subst_keys)
+        msg = unwords
+                [ "PROBE40-FAIL"
+                , "call=" ++ show n
+                , "v=" ++ probe40DescribeVar v
+                , "scope_size=" ++ show sz_scope
+                , "subst_size=" ++ show sz_subst
+                , "scope_first20=[" ++ scope_desc ++ "]"
+                , "subst_keys_first20=[" ++ subst_keys_desc ++ "]"
+                ]
+    hPutStrLn stderr msg
+    hFlush stderr
+    return msg
 
