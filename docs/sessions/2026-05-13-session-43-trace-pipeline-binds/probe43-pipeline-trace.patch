@@ -75,6 +77,46 @@ import GHC.Utils.Logger
 import GHC.Types.Unique.FM      ( pprUniqFM )
 
 import Data.List (mapAccumL)
+import Data.IORef        (IORef, newIORef, atomicModifyIORef')
+import System.IO         (hPutStrLn, stderr, hFlush)
+import System.IO.Unsafe  (unsafePerformIO)
+
+-- PROBE43: trace mg_binds count through the Core pipeline to
+-- find WHICH pass causes the truncation observed by probe42.
+--
+-- Hypothesis from session 42: GC corrupts the [InBind] cons-list
+-- spine.  Probe43 logs `length (mg_binds guts)` at the entry of
+-- runCorePasses and after each pass, so we can pinpoint which
+-- pass is responsible.
+
+{-# NOINLINE probe43Counter #-}
+probe43Counter :: IORef Int
+probe43Counter = unsafePerformIO (newIORef 0)
+
+probe43LogInitial :: Int -> ()
+probe43LogInitial n = unsafePerformIO $ do
+    k <- atomicModifyIORef' probe43Counter (\c -> (c+1, c+1))
+    hPutStrLn stderr $ "PROBE43-INITIAL evt=" ++ show k ++ " mg_binds=" ++ show n
+    hFlush stderr
+
+probe43LogCore2CoreEntry :: Int -> ()
+probe43LogCore2CoreEntry n = unsafePerformIO $ do
+    k <- atomicModifyIORef' probe43Counter (\c -> (c+1, c+1))
+    hPutStrLn stderr $ "PROBE43-CORE2CORE evt=" ++ show k ++ " mg_binds=" ++ show n
+    hFlush stderr
+
+probe43LogPass :: String -> Int -> Int -> ()
+probe43LogPass pass_name n_before n_after = unsafePerformIO $ do
+    k <- atomicModifyIORef' probe43Counter (\c -> (c+1, c+1))
+    let drop_marker = if n_after < n_before then " *** DROPPED" else ""
+    hPutStrLn stderr $ unwords
+      [ "PROBE43-PASS"
+      , "evt=" ++ show k
+      , "pass=" ++ pass_name
+      , "before=" ++ show n_before
+      , "after=" ++ show n_after
+      ] ++ drop_marker
+    hFlush stderr
 
