> # Per-test extra GHC flags.  Mirrors `extra_run_opts(...)` annotations
> # in upstream tests/ghci/scripts/all.T — the flags are appended to
> # the GHC invocation for tests that need a specific REPL mode (eg.
> # -fobject-code) or extra dump flags (eg. -ddump-to-file).
> run_opts_for() {
>   case "$1" in
>     T9878b|T12091) echo "-fobject-code" ;;
>     T17500)        echo "-ddump-to-file -ddump-bcos" ;;
>     *)             echo "" ;;
>   esac
> }
