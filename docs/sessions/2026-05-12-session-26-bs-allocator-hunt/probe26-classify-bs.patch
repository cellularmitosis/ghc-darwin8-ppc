+-- PROBE26 (session 26, 2026-05-12): classify the ForeignPtrContents
+-- of every BS that flows into mkFastStringByteString.
+{-# NOINLINE probe26Counter #-}
+probe26Counter :: IORef Int
+probe26Counter = unsafePerformIO (newIORef 0)
+
+probe26Classify :: BSI.ByteString -> String
+probe26Classify (BSI.BS (GFP.ForeignPtr _ contents) _) = case contents of
+  GFP.PlainForeignPtr _ -> "PlainForeignPtr"
+  GFP.FinalPtr          -> "FinalPtr"
+  GFP.MallocPtr mba _   ->
+    if isTrue# (isMutableByteArrayPinned# mba)
+      then "MallocPtr+pinned" else "MallocPtr+UNPINNED"
+  GFP.PlainPtr mba      ->
+    if isTrue# (isMutableByteArrayPinned# mba)
+      then "PlainPtr+pinned"  else "PlainPtr+UNPINNED"
+
+probe26Trace :: BSI.ByteString -> IO ()
+probe26Trace bs = do
+  let !tag = probe26Classify bs
+  let !len = BS.length bs
+  n <- atomicModifyIORef' probe26Counter (\x -> (x+1, x))
+  let isUnpinned = case tag of
+        "MallocPtr+UNPINNED" -> True
+        "PlainPtr+UNPINNED"  -> True
+        _                    -> False
+  -- Print every call up to 50, then only the UNPINNED cases.  Flush
+  -- after each line so we don't lose output to the SIGSEGV.
+  when (n < 50 || isUnpinned) $ do
+    hPutStrLn stderr ("PROBE26 #" ++ show n ++ " " ++ tag ++ " len=" ++ show len)
+    hFlush stderr
+
 -- | Create a 'FastString' by copying an existing 'ByteString'
 mkFastStringByteString :: ByteString -> FastString
-mkFastStringByteString bs =
