-  inlinePerformIO $
-      mkFastStringWith (mkNewFastStringShortByteString sbs) sbs
+mkFastStringByteString bs = inlinePerformIO $ do
+  probe26Trace bs
+  let sbs = SBS.toShort bs
+  mkFastStringWith (mkNewFastStringShortByteString sbs) sbs
 
