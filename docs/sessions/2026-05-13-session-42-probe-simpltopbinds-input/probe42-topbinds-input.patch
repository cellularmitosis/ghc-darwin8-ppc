+import Data.IORef        (IORef, newIORef, atomicModifyIORef')
+import System.IO         (hPutStrLn, stderr, hFlush)
+import System.IO.Unsafe  (unsafePerformIO)
+
+-- PROBE42: dump simplTopBinds' input shape — number of binding
+-- groups (top-level Recs/NonRecs) and total binder count.
+--
+-- Hypothesis from session 41: in failing runs, simplRecBndrs's
+-- first call has scope=2 instead of scope=10.  If binds0
+-- (simplTopBinds' input CoreProgram) has only 2 binders in
+-- failing runs but 10 in clean runs, the corruption is UPSTREAM
+-- of simplTopBinds — in the typechecker/desugarer/specializer/
+-- interface deserializer pipeline.
+
+{-# NOINLINE probe42Counter #-}
+probe42Counter :: IORef Int
+probe42Counter = unsafePerformIO (newIORef 0)
+
+probe42DumpBinds0 :: Int -> Int -> ()
+probe42DumpBinds0 num_groups num_binders = unsafePerformIO $ do
+    n <- atomicModifyIORef' probe42Counter (\k -> (k+1, k+1))
+    hPutStrLn stderr $ unwords
+      [ "PROBE42-TOPBINDS"
+      , "call=" ++ show n
+      , "num_groups=" ++ show num_groups
+      , "num_binders=" ++ show num_binders
+      ]
+    hFlush stderr
 
