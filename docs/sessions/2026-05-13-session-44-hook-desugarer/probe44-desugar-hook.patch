+import System.IO         (hPutStrLn, stderr, hFlush)
+import System.IO.Unsafe  (unsafePerformIO)
+
+-- PROBE44: trace mg_binds count at the desugarer's exit.
+-- Hypothesis from session 43: the [InBind] truncation happens
+-- BEFORE core2core entry.  Probe44 logs final_prs length (the
+-- desugarer's main output before simpleOptPgm), ds_binds length
+-- (after simpleOptPgm runs), and the final mg_binds length
+-- stored in ModGuts.
+
+{-# NOINLINE probe44Counter #-}
+probe44Counter :: IORef Int
+probe44Counter = unsafePerformIO (newIORef 0)
+
+probe44LogDeSugarReturn :: Int -> Int -> Int -> ()
+probe44LogDeSugarReturn n_final_prs n_ds_binds n_mg_binds =
+    unsafePerformIO $ do
+      k <- atomicModifyIORef' probe44Counter (\c -> (c+1, c+1))
+      hPutStrLn stderr $ unwords
+        [ "PROBE44-DESUGAR-RETURN"
+        , "evt=" ++ show k
+        , "final_prs=" ++ show n_final_prs
+        , "ds_binds=" ++ show n_ds_binds
+        , "mg_binds=" ++ show n_mg_binds
+        ]
+      hFlush stderr
 
